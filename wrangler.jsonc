// Configuración de Cloudflare para la tienda (Worker + archivos estáticos).
// - El sitio se sirve tal cual desde esta carpeta (lo que no se publica está en .assetsignore).
// - Sólo /api/* pasa por src/worker.js (copia de cada pedido por mail).
// - La casilla de destino NO va acá (el repo es público): se carga como secreto
//   MAIL_TO en Cloudflare → Settings → Variables and Secrets.
{
  "name": "mbsublimarte-tienda",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "MAIL" }
  ],
  // No borrar en cada deploy las variables cargadas desde el panel (MAIL_TO).
  "keep_vars": true,
  // Logs del Worker visibles en Cloudflare → Observability.
  "observability": { "enabled": true }
}
